# CloseHound — environment template. Copy to .env.local and fill in real values.
# Everything here is server-side only UNLESS prefixed NEXT_PUBLIC_.
# Never commit real secrets — .env.local is gitignored; this file holds names only.

# Mock mode — serve fixtures, make ZERO live/billable API calls. "1" to enable.
MOCK_MODE=
NEXT_PUBLIC_MOCK_MODE=

# Supabase (new prefix-format keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# HUD FMR/SAFMR + USPS ZIP crosswalk — Bearer token
HUDUSER_API_KEY=

# RentCast — sent as X-Api-Key header
RENTCAST_API_KEY=

# Stripe (Phase 11)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Canonical site origin (used for metadata, canonical URLs)
NEXT_PUBLIC_SITE=
