# Supabase — required. Loader prefers SUPABASE_SECRET_KEY (modern name) and
# falls back to SUPABASE_SERVICE_ROLE_KEY to match the TS code's precedence
# (see src/lib/supabase.ts).
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# FL Sunbiz SFTP — public data, public credentials. The host and credentials
# below are published by Florida DOS on their data-download page; they're not
# secret, but we keep them out of code for hygiene.
# Source: https://floridados.gov/sunbiz/other-services/data-downloads/
FL_SUNBIZ_SFTP_HOST=sftp.floridados.gov
FL_SUNBIZ_SFTP_PORT=22
FL_SUNBIZ_SFTP_USER=Public
FL_SUNBIZ_SFTP_PASSWORD=PubAccess1845!
FL_SUNBIZ_SFTP_PATH=/Public/doc/cor

# GA SOS scrape (no key required; we just need a polite UA).
GA_SOS_USER_AGENT=CloseHoundBot/0.1 (lead-ingestion; contact: hello@walkperro.com)

# KY SOS delta-file index URL (occasionally changes — update when KY moves it).
KY_SOS_INDEX_URL=https://web.sos.ky.gov/business/filings/

# NY DOS open data Socrata endpoint. Dataset = "Active Corporations: Beginning
# 1800" (n9v6-gdp6). The .json endpoint supports $where date filters + pagination.
NY_DOS_DATASET_URL=https://data.ny.gov/resource/n9v6-gdp6.json

# Per-source toggles — flip to "0" to disable while debugging the others.
SOURCE_FL_SUNBIZ_ENABLED=1
SOURCE_GA_SOS_ENABLED=1
SOURCE_KY_SOS_ENABLED=1
SOURCE_NY_DOS_ENABLED=1
